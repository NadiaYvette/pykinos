cabal-version: 3.0
name: pykinos-core
version: 0.1.0.0
synopsis: Unboxed SIMD Roaring Bitmaps, ART IntMap, B+ and FAST search trees
license: Apache-2.0
build-type: Simple
tested-with: GHC == 9.14.1

library
    exposed-modules:
        Pykinos.Bitset.Roaring
        Pykinos.IntMap.ART
        Pykinos.Tree.BPlus
        Pykinos.Tree.FAST
        Pukinos.Bitset.Roaring
        Pukinos.IntMap.ART
        Pukinos.Tree.BPlus
        Pukinos.Tree.FAST
    hs-source-dirs: src
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wno-unused-imports
    build-depends:
        base >= 4.19 && < 5,
        primitive >= 0.9,
        containers >= 0.6

test-suite pykinos-core-test
    type: exitcode-stdio-1.0
    main-is: Spec.hs
    hs-source-dirs: test
    default-language: GHC2024
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.19 && < 5,
        pykinos-core,
        primitive >= 0.9,
        containers >= 0.6

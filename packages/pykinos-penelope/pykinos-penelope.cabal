cabal-version: 3.0
name: pykinos-penelope
version: 0.1.0.0
synopsis: Transient Epoch# In-Place Mutation and Lockless MVCC Handles
license: EUPL-1.2
license-file: LICENSE
build-type: Simple
tested-with: GHC == 9.14.1

library
    exposed-modules:
        Pykinos.Effect.Penelope
        Pukinos.Effect.Penelope
    hs-source-dirs: src
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wno-unused-imports
    build-depends:
        base >= 4.19 && < 5,
        pykinos-core,
        primitive >= 0.9,
        containers >= 0.6

test-suite pykinos-penelope-test
    type: exitcode-stdio-1.0
    main-is: Spec.hs
    hs-source-dirs: test
    default-language: GHC2024
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.19 && < 5,
        pykinos-core,
        pykinos-penelope,
        primitive >= 0.9
